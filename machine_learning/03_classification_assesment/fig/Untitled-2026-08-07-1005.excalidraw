      "created": 1791735445884,
      "link": null,
      "locked": false,
      "text": "Una clasificación perfecta haría  300  0\n                                            0     300\n\nrecall = precision =  300 / (300 + 0) = 1",
      "fontSize": 12.531144238079138,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "NiVhuAAFjHnQlgvd_XdMc",
      "originalText": "Una clasificación perfecta haría  300  0\n                                            0     300\n\nrecall = precision =  300 / (300 + 0) = 1",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
