    {
      "id": "Gp-plbGdphVi2MBasPDiu",
      "type": "text",
      "x": -366.478374026989,
      "y": 14.608035063687055,
      "width": 800,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff5f5",
      "fillStyle": "cross-hatch",
      "strokeWidth": 1,
