      "version": 283,
      "versionNonce": 645023877,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791737489679,
      "created": 1791737305465,
      "link": null,
      "locked": false,
      "text": "La elección del umbral depende del negocio. ¿Qué nos duele menos: gastar más dinero en clientes que\nparecían interesados pero no lo estaban (FN), o dejar ir clientes que parecían no_interesados pero sí\nlo estaban (FP)?",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La elección del umbral depende del negocio. ¿Qué nos duele menos: gastar más dinero en clientes que parecían interesados pero no lo estaban (FN), o dejar ir clientes que parecían no_interesados pero sí lo estaban (FP)?",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
